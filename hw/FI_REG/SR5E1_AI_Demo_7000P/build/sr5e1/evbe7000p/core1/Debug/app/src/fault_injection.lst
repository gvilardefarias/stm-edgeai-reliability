 374:app/src/fault_injection.c **** /* TIM2 IRQ: save all registers, call the dispatcher, restore all registers
 375:app/src/fault_injection.c ****  * (one of them has the bit flip). */
 376:app/src/fault_injection.c **** __attribute__((naked)) void IRQ_TIM2_HANDLER(void) {
 1846              		.loc 1 376 52
 1847              		.cfi_startproc
 1848              		@ Naked Function: prologue and epilogue provided by programmer.
 1849              		@ args = 0, pretend = 0, frame = 0
 1850              		@ frame_needed = 0, uses_anonymous_args = 0
 377:app/src/fault_injection.c ****     __asm volatile (
 1851              		.loc 1 377 5
 1852              		.syntax unified
 1853              	@ 377 "app/src/fault_injection.c" 1
 1854 0000 1EF0040F 		TST    LR, #4          
 1855 0004 0CBF     	ITE    EQ              
 1856 0006 EFF30880 	MRSEQ  R0, MSP         
 1857 000a EFF30980 	MRSNE  R0, PSP         
 1858 000e 2DE9F00F 	PUSH   {R4-R11}        
 1859 0012 6946     	MOV    R1, SP          
 1860 0014 2DED108A 	VPUSH  {S16-S31}       
 1861 0018 6B46     	MOV    R3, SP          
 1862 001a 7246     	MOV    R2, LR          
 1863 001c 10B5     	PUSH   {R4, LR}        
 1864 001e FFF7FEFF 	BL     fi_dispatch     
 1865 0022 BDE81040 	POP    {R4, LR}        
 1866 0026 BDEC108A 	VPOP	{S16-S31}		
 1867 002a BDE8F00F 	POP    {R4-R11}        
 1868 002e 7047     	BX     LR              
 1869              	
 1870              	@ 0 "" 2
 378:app/src/fault_injection.c ****         "TST    LR, #4          \n"   /* Interrupted thread on MSP or PSP?  */
 379:app/src/fault_injection.c ****         "ITE    EQ              \n"
 380:app/src/fault_injection.c ****         "MRSEQ  R0, MSP         \n"   /* R0 = frame HW                    */
 381:app/src/fault_injection.c ****         "MRSNE  R0, PSP         \n"
 382:app/src/fault_injection.c ****         "PUSH   {R4-R11}        \n"   /* R4..R11 copy */
 383:app/src/fault_injection.c ****         "MOV    R1, SP          \n"   /* R1 = address of R4..R11 copy */
 384:app/src/fault_injection.c ****     	"VPUSH  {S16-S31}       \n"   /* S16..S31 copy */
 385:app/src/fault_injection.c ****     	"MOV    R3, SP          \n"   /* R3 = address of S16..S31 copy */
 386:app/src/fault_injection.c ****         "MOV    R2, LR          \n"   /* R2 = EXC_RETURN                  */
 387:app/src/fault_injection.c ****         "PUSH   {R4, LR}        \n"   /* save EXC_RETURN (R4 is just for align SP to 8 byte)  */
 388:app/src/fault_injection.c ****         "BL     fi_dispatch     \n"	  /* fi_dispatch(frame, r4_r11, exc_ret, s16_31)*/
 389:app/src/fault_injection.c ****         "POP    {R4, LR}        \n"
 390:app/src/fault_injection.c ****     	"VPOP	{S16-S31}		\n"	  /* reload S16..S31 from copy */
 391:app/src/fault_injection.c ****         "POP    {R4-R11}        \n"   /* reload R4..R11 from copy */
 392:app/src/fault_injection.c ****         "BX     LR              \n"   /* the HW reload R0-R3, R12, S0-S15, FPSCR from frame */
 393:app/src/fault_injection.c ****     );
 394:app/src/fault_injection.c **** }
