 439:app/src/fault_injection.c ****     __asm volatile (
 2322              		.loc 1 439 5
 2323              		.syntax unified
 2324              	@ 439 "app/src/fault_injection.c" 1
 2325 0000 1EF0040F 		TST    LR, #4          
 2326 0004 0CBF     	ITE    EQ              
 2327 0006 EFF30880 	MRSEQ  R0, MSP         
 2328 000a EFF30980 	MRSNE  R0, PSP         
 2329 000e 2DE9F00F 	PUSH   {R4-R11}        
 2330 0012 6946     	MOV    R1, SP          
 2331 0014 2DED108A 	VPUSH  {S16-S31}       
 2332 0018 6B46     	MOV    R3, SP          
 2333 001a 7246     	MOV    R2, LR          
 2334 001c 10B5     	PUSH   {R4, LR}        
 2335 001e FFF7FEFF 	BL     fi_dispatch     
 2336 0022 BDE81040 	POP    {R4, LR}        
