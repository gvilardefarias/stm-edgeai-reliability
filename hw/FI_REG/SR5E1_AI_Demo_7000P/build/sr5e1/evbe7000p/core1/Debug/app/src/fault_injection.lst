 436:app/src/fault_injection.c **** /* TIM2 IRQ: save all registers, call the dispatcher, restore all registers
 437:app/src/fault_injection.c ****  * (one of them has the bit flip). */
 438:app/src/fault_injection.c **** __attribute__((naked)) void IRQ_TIM2_HANDLER(void) {
 2317              		.loc 1 438 52
 2318              		.cfi_startproc
 2319              		@ Naked Function: prologue and epilogue provided by programmer.
