 786              	
 787              	@ 0 "" 2
 162:app/src/fault_injection.c ****         "TST    LR, #4          \n"   /* thread interrotto su MSP o PSP?  */
 163:app/src/fault_injection.c ****         "ITE    EQ              \n"
 164:app/src/fault_injection.c ****         "MRSEQ  R0, MSP         \n"   /* R0 = frame HW                    */
 165:app/src/fault_injection.c ****         "MRSNE  R0, PSP         \n"
 166:app/src/fault_injection.c ****         "VPUSH  {S16-S31}       \n"   /* copia di S16..S31; prima istruzione FPU:
 167:app/src/fault_injection.c ****                                              forza il salvataggio lazy di S0-S15/FPSCR nel frame */
 168:app/src/fault_injection.c ****         "MOV    R1, SP          \n"   /* R1 = indirizzo della copia             */
 169:app/src/fault_injection.c ****         "MOV    R2, LR          \n"   /* R2 = EXC_RETURN                        */
 170:app/src/fault_injection.c ****         "PUSH   {R4, LR}        \n"   /* salva EXC_RETURN (R4: SP allineato a 8) */
 171:app/src/fault_injection.c ****         "BL     fi_dispatch     \n"   /* fi_dispatch(frame, s16_s31, exc_ret)   */
 172:app/src/fault_injection.c ****         "POP    {R4, LR}        \n"
 173:app/src/fault_injection.c ****         "VPOP   {S16-S31}       \n"   /* ricarica S16..S31 dalla copia, eventualmente modificata */
 174:app/src/fault_injection.c ****         "BX     LR              \n"   /* l'HW ricarica R0-R3, R12, S0-S15, FPSCR dal frame */
 175:app/src/fault_injection.c ****     );
 176:app/src/fault_injection.c **** }
