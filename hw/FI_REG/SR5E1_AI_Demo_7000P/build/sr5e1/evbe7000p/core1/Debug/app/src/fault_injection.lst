 2340              	
 2341              	@ 0 "" 2
 440:app/src/fault_injection.c ****         "TST    LR, #4          \n"   /* Interrupted thread on MSP or PSP?  */
 441:app/src/fault_injection.c ****         "ITE    EQ              \n"
 442:app/src/fault_injection.c ****         "MRSEQ  R0, MSP         \n"   /* R0 = frame HW                    */
 443:app/src/fault_injection.c ****         "MRSNE  R0, PSP         \n"
 444:app/src/fault_injection.c ****         "PUSH   {R4-R11}        \n"   /* R4..R11 copy */
 445:app/src/fault_injection.c ****         "MOV    R1, SP          \n"   /* R1 = address of R4..R11 copy */
 446:app/src/fault_injection.c ****     	"VPUSH  {S16-S31}       \n"   /* S16..S31 copy */
 447:app/src/fault_injection.c ****     	"MOV    R3, SP          \n"   /* R3 = address of S16..S31 copy */
 448:app/src/fault_injection.c ****         "MOV    R2, LR          \n"   /* R2 = EXC_RETURN                  */
 449:app/src/fault_injection.c ****         "PUSH   {R4, LR}        \n"   /* save EXC_RETURN (R4 is just for align SP to 8 byte)  */
 450:app/src/fault_injection.c ****         "BL     fi_dispatch     \n"	  /* fi_dispatch(frame, r4_r11, exc_ret, s16_31)*/
 451:app/src/fault_injection.c ****         "POP    {R4, LR}        \n"
 452:app/src/fault_injection.c ****     	"VPOP	{S16-S31}		\n"	  /* reload S16..S31 from copy */
 453:app/src/fault_injection.c ****         "POP    {R4-R11}        \n"   /* reload R4..R11 from copy */
 454:app/src/fault_injection.c ****         "BX     LR              \n"   /* the HW reload R0-R3, R12, S0-S15, FPSCR from frame */
 455:app/src/fault_injection.c ****     );
 456:app/src/fault_injection.c **** }
