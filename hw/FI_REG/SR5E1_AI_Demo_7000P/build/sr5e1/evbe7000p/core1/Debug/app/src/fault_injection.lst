 774 0000 1EF0040F 		TST    LR, #4          
 775 0004 0CBF     	ITE    EQ              
 776 0006 EFF30880 	MRSEQ  R0, MSP         
 777 000a EFF30980 	MRSNE  R0, PSP         
 778 000e 2DED108A 	VPUSH  {S16-S31}       
 779 0012 6946     	MOV    R1, SP          
 780 0014 7246     	MOV    R2, LR          
 781 0016 10B5     	PUSH   {R4, LR}        
 782 0018 FFF7FEFF 	BL     fi_dispatch     
