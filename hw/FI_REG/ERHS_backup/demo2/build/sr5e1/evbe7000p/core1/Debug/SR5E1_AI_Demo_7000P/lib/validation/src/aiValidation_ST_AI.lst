 243:SR5E1_AI_Demo_7000P/lib/misc/inc/aiTestUtility.h ****     for (int i = 0; i < 8; i++) {\
 244:SR5E1_AI_Demo_7000P/lib/misc/inc/aiTestUtility.h ****       if (*pr != 0xDEDEDEDE)\
 245:SR5E1_AI_Demo_7000P/lib/misc/inc/aiTestUtility.h ****       overflow = true;\
