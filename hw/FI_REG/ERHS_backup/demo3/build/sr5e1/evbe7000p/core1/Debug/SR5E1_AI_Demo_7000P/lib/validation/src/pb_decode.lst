 489:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     /* Check for multiplication overflows.
 490:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****      * This code avoids the costly division if the sizes are small enough.
 491:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****      * Multiplication is safe as long as only half of bits are set
 492:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****      * in either multiplicand.
 493:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****      */
 494:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     {
 495:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****         const size_t check_limit = (size_t)1 << (sizeof(size_t) * 4);
 496:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****         if (data_size >= check_limit || array_size >= check_limit)
 497:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****         {
 498:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****             const size_t size_max = (size_t)-1;
 499:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****             if (size_max / array_size < data_size)
 500:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****             {
 501:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****                 PB_RETURN_ERROR(stream, "size too large");
 502:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****             }
 503:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****         }
 504:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     }
 505:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     
 506:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     /* Allocate new or expand previous allocation */
 507:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     /* Note: on failure the old pointer will remain in the structure,
 508:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****      * the message must be freed by caller also on error return. */
 509:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     ptr = pb_realloc(ptr, array_size * data_size);
 510:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     if (ptr == NULL)
 511:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****         PB_RETURN_ERROR(stream, "realloc failed");
 512:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     
 513:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     *(void**)pData = ptr;
 514:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****     return true;
 515:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c **** }
