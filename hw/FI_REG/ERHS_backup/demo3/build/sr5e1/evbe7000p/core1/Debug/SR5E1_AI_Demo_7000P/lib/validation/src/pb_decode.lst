 478:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c **** /* Allocate storage for the field and store the pointer at iter->pData.
 479:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****  * array_size is the number of entries to reserve in an array.
 480:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****  * Zero size is not allowed, use pb_free() for releasing.
 481:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c ****  */
 482:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c **** static bool checkreturn allocate_field(pb_istream_t *stream, void *pData, size_t data_size, size_t 
 483:SR5E1_AI_Demo_7000P/lib/validation/src/pb_decode.c **** {    
